# Wohinfahrma – Webordner
#
# Startseite ist die Rangliste.
DirectoryIndex index.php index.html

# Passwortdateien nie ausliefern
<FilesMatch "^\.ht">
  Require all denied
</FilesMatch>

# Schrift mit passendem Typ und lange im Cache (Dateiname wechselt bei Aenderung)
<IfModule mod_mime.c>
  AddType font/woff .woff
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.woff$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>

# Service Worker nicht aus dem HTTP-Cache, damit Aenderungen ankommen
<IfModule mod_headers.c>
  <Files "sw.js">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>

# Seit 7.11.2026 laeuft die App unter wohinfahrma.de (gleicher Ordner).
# Alte Adresse und www dauerhaft dorthin umleiten, Pfad und Query bleiben
# erhalten (wie bei ammerseewind.de). http -> https erledigt die
# HTTPS-Weiterleitung im SSL-Manager der konsoleH.
RewriteEngine On
RewriteCond %{HTTP_HOST} ^(wohinfahrma\.dablank\.de|www\.wohinfahrma\.de)$ [NC]
RewriteRule ^(.*)$ https://wohinfahrma.de/$1 [R=301,L]
